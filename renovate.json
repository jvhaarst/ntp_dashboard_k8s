{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pin"
      ],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    },
    {
      "matchDepNames": [
        "quay.io/superq/chrony-exporter"
      ],
      "groupName": "chrony-exporter image"
    },
    {
      "matchDepNames": [
        "ghcr.io/brendanbank/gpsd-prometheus-exporter"
      ],
      "groupName": "gpsd-prometheus-exporter image"
    },
    {
      "matchDepNames": [
        "cturra/ntp"
      ],
      "groupName": "chronyc helper image"
    },
    {
      "matchDepNames": [
        "observabilitystack/geoip-api"
      ],
      "groupName": "geoip-api image"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^ntp-exporters/values\\.yaml$/"
      ],
      "matchStrings": [
        "repository:\\s*(?<depName>cturra/ntp)\\s*\\n\\s*tag:\\s*\"(?<currentValue>[^\"]+)\"\\s*\\n\\s*digest:\\s*\"(?<currentDigest>sha256:[a-f0-9]+)\""
      ],
      "datasourceTemplate": "docker"
    }
  ]
}
